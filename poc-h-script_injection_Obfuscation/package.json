{
  "name": "poc-h-script-injection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:main": "node server-main.js",
    "start:thirdparty": "node server-thirdparty.js",
    "start:collector": "node server-collect-ws.js",
